# Copy this file to .env (which is gitignored) and fill in your DNS provider's
# credentials. global_defs.sh sources .env with auto-export, so lego reads them
# straight from the environment.
#
# Run `lego dnshelp -c <provider>` to see exactly which variables you need.

# --- CloudFlare: scoped API token (recommended) ---
# CLOUDFLARE_DNS_API_TOKEN=""

# --- CloudFlare: legacy global API key ---
# CLOUDFLARE_EMAIL="you@example.com"
# CLOUDFLARE_API_KEY=""

# --- AWS Route53 ---
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
